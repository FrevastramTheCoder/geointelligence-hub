# Active bridge configuration
HOST=127.0.0.1
PORT=5001
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
DATABASE_PATH=geointelligence.db
DEBUG=false

# Generate unique values with: python generate_keys.py --write
# Never commit the real values. Rotating TOKEN_ENCRYPTION_KEY
# invalidates sealed EE tokens and forces users to re-connect GEE.
SESSION_SECRET=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=replace-with-a-fernet-key
# Optional: 20 req / 10 min per IP on login+register+google-login
# RATE_LIMIT_MAX_ATTEMPTS=20
# RATE_LIMIT_WINDOW_SECONDS=600

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5001/api/gee/oauth/callback

# Optional server-side services
GEMINI_API_KEY=
ADMIN_KEY=
